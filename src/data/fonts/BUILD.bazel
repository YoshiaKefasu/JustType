# Gen Interface JP Display faces, shipped inside the MSI under
# <JustTypeDir>\fonts.
#
# The candidate window and the config dialog both ask for the family by name
# and register these files per process (AddFontResourceExW with FR_PRIVATE on
# the renderer side, QFontDatabase::addApplicationFont on the dialog side), so
# the product face resolves on a machine where the user never installed it.
# Regular and Bold are both required: the candidate window weights its labels,
# and a weight GDI cannot find is synthesised by the rasteriser instead of
# being drawn from the shipped outlines.

package(default_visibility = ["//win32/installer:__pkg__"])

exports_files([
    "GenInterfaceJPDisplay-Regular.ttf",
    "GenInterfaceJPDisplay-Bold.ttf",
], visibility = [
    "//session:__pkg__",
    "//win32/installer:__pkg__",
])
