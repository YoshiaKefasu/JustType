)

# End-to-end pipeline: romaji input -> romanization -> Meltype English/Japanese
# segmentation -> live conversion -> SystemOne decision -> commit, together with
# the keymap binding and the bundled-font registration the same pipeline relies
# on.
#
# The stages under test are the production ones (meltype_piece_pipeline.cc,
# systemone_client.cc, systemone_logger.cc, win32_font_resource.cc) driven with
# the real dictionary files, the real romanji-hiragana table and the real
# ms-ime.tsv keymap.  Only the dictionary converter is mocked, which is the same
# simplification Mozc's own session tests make (they use
# MockEngineConverterInterface).
mozc_cc_test(
    name = "session_e2e_test",
    size = "small",
    srcs = ["session_e2e_test.cc"],
    target_compatible_with = ["@platforms//os:windows"],
    data = [
        "//data/fonts:GenInterfaceJPDisplay-Regular.ttf",
        "//data/fonts:GenInterfaceJPDisplay-Bold.ttf",
        "//data/keymap:keymap_files",
        "//data/preedit:composition_table",
        "//meltype:meltype_dictionaries",
        # The [7] keymap checks read keymap.cc out of the source tree to make
        # sure the commands ms-ime.tsv names are the ones actually registered.
        # Without it the runfiles do not carry the file and the read comes back
        # empty, which reads as "nothing is registered" rather than as the
        # missing data it is.
        "//session:keymap.cc",
    ],
    deps = [
        ":meltype_piece_pipeline",
        ":systemone_client",
        ":systemone_logger",
        "//meltype:meltype_segmenter",
        "//renderer/win32:win32_font_resource",
    ],
)

