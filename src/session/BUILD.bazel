# Piece pipeline: Mozc's multi-clause conversion stays the baseline; Meltype
# protects the English pieces on top of it (typed letters with the boundary
# spaces), aligns its piece boundaries against the reading (refusing toward
# "show Mozc" when they disagree), and feeds the SystemOne questions their
# left contexts and options.
#
# Deliberately free of protobuf: the pipeline has to reason about readings as
# characters, and a protobuf dependency would confine it to the Session
# build, which cannot be exercised without the whole engine.  Keeping it
# standalone is what lets //session:session_e2e_test run the exact same code
# the key-event path runs, against the real dictionaries and the real
# SystemOne client.
mozc_cc_library(
    name = "meltype_piece_pipeline",
    srcs = ["meltype_piece_pipeline.cc"],
    hdrs = ["meltype_piece_pipeline.h"],
    visibility = [
        "//session:__pkg__",
    ],
    deps = [
        # base:util for Util::CharsLen / Utf8SubString: the English-boundary
        # slice splits values at character granularity.  No protobuf — the
        # target stays standalone (see the comment above).
        "//base:util",
        "//meltype:meltype_segmenter",
    ],
)

