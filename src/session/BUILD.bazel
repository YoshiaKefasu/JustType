# SystemOne (Jev / Laya) client.  Talks to the SystemOne endpoint directly
# over WinHTTP with no external proxy; see systemone_client.h for the wire
# format, which mirrors tools/mozkey-jev-bridge/internal/jev/client.go.
mozc_cc_library(
    name = "systemone_logger",
    srcs = ["systemone_logger.cc"],
    hdrs = ["systemone_logger.h"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//session:__pkg__"],
    # systemone_logger.h includes systemone_client.h for the request and
    # response types it formats.
    deps = [
        ":systemone_client",
    ],
)

mozc_cc_library(
    name = "systemone_client",
    srcs = ["systemone_client.cc"],
    hdrs = ["systemone_client.h"],
