    name = "systemone_worker",
    srcs = ["systemone_worker.cc"],
    hdrs = ["systemone_worker.h"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//session:__pkg__"],
    deps = [
        ":systemone_client",
    ],
)

