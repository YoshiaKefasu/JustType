<?define QtCoreFilename="Qt$(var.QtVer)Core.dll" ?>
<?define QtCoredFilename="Qt$(var.QtVer)Cored.dll" ?>
<?define QtGuiFilename="Qt$(var.QtVer)Gui.dll" ?>
<?define QtGuidFilename="Qt$(var.QtVer)Guid.dll" ?>
<?define QtWidgetsFilename="Qt$(var.QtVer)Widgets.dll" ?>
<?define QtWidgetsdFilename="Qt$(var.QtVer)Widgetsd.dll" ?>

<?ifndef JustTypeTIP64ArmPath ?>
  <?define JustTypeTIP64ArmPath="" ?>
<?endif?>
<?ifndef JustTypeTIP64XPath ?>
  <?define JustTypeTIP64XPath="" ?>
<?endif?>
<?ifndef JustTypeUniversalInstaller ?>
  <?define JustTypeUniversalInstaller="" ?>
<?endif?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!--
    It appears that Windows Installer emits error on upgrade saying "Another
    version of this product is already installed" unless we change the product
    ID even when we follow the instructions in "Changing the Product Code"
    http://msdn.microsoft.com/en-us/library/aa367850.aspx.
    So we change the product ID for every new version.
  -->
  <Package Name="JustType" Language="1041" Codepage="932" Version="$(var.JustTypeVersion)" Manufacturer="YoshiaKefasu" UpgradeCode="$(var.UpgradeCode)" InstallerVersion="500" Scope="perMachine">
    <SummaryInformation Keywords="Installer" Description="JustType インストーラー" Manufacturer="YoshiaKefasu" Codepage="932" />

    <!--
       While obtaining the OS build number from the registry does not seem to be officially
       explained, there are several articles in the Microsoft website that do mention how to do so
       with the registry value.
         https://learn.microsoft.com/en-us/fslogix/reference-configuration-settings#custom-environment-variables
         https://learn.microsoft.com/en-us/intune/intune-service/apps/apps-win32-deploy-update-package

       Here are other examples that use the same registry value to check the OS build number.
         Microsoft PowerToys
           https://github.com/microsoft/PowerToys/blob/ca473b488bc3df626140cd332b9a1ea4ff1fcdf2/installer/PowerToysSetup/Product.wxs#L43-L45
         Google bindiff
           https://github.com/google/bindiff/blob/7e4d0375035b2353f22f44311f747eedafd98c4e/packaging/msi/Setup.wxs#L70-L75

                         Build Number
       Windows 10 1507      10240
       Windows 10 1511      10586
       Windows 10 1607      14393
       Windows 10 1703      15063
       Windows 10 1709      16299
       Windows 10 1803      17134
       Windows 10 1809      17763
       Windows 10 1903      18362
       Windows 10 1903      18362
       Windows 10 1909      18363
       Windows 10 2004      19041
       Windows 10 20H2      19042
       Windows 10 21H1      19043
       Windows 10 21H2      19044
       Windows 10 22H2      19045

       Windows 11 21H2      22000
       Windows 11 22H2      22621
       Windows 11 23H2      22631
       Windows 11 24H2      26100

       Note that this needs to be a secure property. Otherwise, it becomes an unexpected value in
       the repair/uninstall mode. See https://github.com/google/mozc/issues/1410
    -->
    <Property Id="OS_BUILD_NUMBER" Secure="yes">
      <RegistrySearch Id="CurrentBuildNumberValue" Type="raw" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" />
    </Property>
    <Launch Condition="(OS_BUILD_NUMBER AND (OS_BUILD_NUMBER &gt;= 17763)) OR (REMOVE=&quot;ALL&quot;)" Message="JustType をインストールするには Windows 10 1809 以降にアップグレードする必要があります。" />

    <!-- Check if the user have the administrative privileges. -->
    <Launch Condition="Privileged" Message="JustType をインストールするには管理者権限が必要です。" />
    <Media Id="1" Cabinet="JustType.cab" EmbedCab="yes" CompressionLevel="high" />

    <?if $(var.JustTypeTIP64ArmPath) == "" and $(var.JustTypeTIP64XPath) == "" and $(var.JustTypeUniversalInstaller) == "" ?>
      <!--
        This needs to be a secure property. Otherwise, it becomes an unexpected value in the
        repair/uninstall mode. See https://github.com/google/mozc/issues/1410
      -->
      <Property Id="PROCESSOR_ARCHITECTURE" Secure="yes">
        <RegistrySearch Id="ProcessorArchitectureValue" Type="raw" Root="HKLM" Key="System\CurrentControlSet\Control\Session Manager\Environment" Name="PROCESSOR_ARCHITECTURE" />
      </Property>
      <Launch Condition="(NOT (PROCESSOR_ARCHITECTURE=&quot;ARM64&quot;)) OR UPGRADING OR (REMOVE=&quot;ALL&quot;)" Message="ARM64 環境へのインストールは未対応です" />
    <?endif?>

    <!-- Set Add/Remove Program Icon -->
    <Icon Id="add_remove_program_icon.ico" SourceFile="$(var.AddRemoveProgramIconPath)" />
    <Property Id="ARPPRODUCTICON" Value="add_remove_program_icon.ico" />

    <!-- Disable Modify and Repair buttons. -->
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <!-- Never prompt for a reboot. The TIP registration and the firewall rules
         are both applied per machine and take effect without a restart, and an
         IME installer that reboots the machine loses whatever the user was
         typing in other applications. -->
    <Property Id="REBOOT" Value="ReallySuppress" />

    <!--
       TODO: Consider migrating to "MajorUpgrade" rule.
       See https://github.com/google/mozc/issues/734#issuecomment-1524294119
    -->
    <Upgrade Id="$(var.UpgradeCode)">
      <UpgradeVersion Minimum="0.0.0.0" IncludeMinimum="yes" Maximum="$(var.JustTypeVersion)" IncludeMaximum="yes" OnlyDetect="no" Property="UPGRADING" />
      <UpgradeVersion Minimum="$(var.JustTypeVersion)" IncludeMinimum="no" OnlyDetect="yes" Property="NEWERVERSIONDETECTED" />
    </Upgrade>

    <UI>
      <Error Id="4000" Message="新しいバージョンの JustType が既にインストールされています。" />
    </UI>

    <Feature Id="JustTypeInstall" Title="JustType" Level="1">
      <ComponentRef Id="JustTypeTIP32" />
      <ComponentRef Id="JustTypeTIP64" />
      <?if $(var.JustTypeTIP64ArmPath) != "" and $(var.JustTypeTIP64XPath) != "" ?>
        <ComponentRef Id="JustTypeTIP64Arm" />
        <ComponentRef Id="JustTypeTIP64X" />
      <?endif?>
      <ComponentRef Id="JustTypeBroker" />
      <ComponentRef Id="JustTypeConverter" />
      <ComponentRef Id="JustTypeCacheService" />
      <ComponentRef Id="JustTypeRenderer" />
      <ComponentRef Id="JustTypeTool" />
      <?if $(var.VSConfigurationName) = "Release" ?>
        <ComponentRef Id="msvcp140" />
        <ComponentRef Id="msvcp140_1" />
        <ComponentRef Id="msvcp140_2" />
        <ComponentRef Id="vcruntime140" />
        <ComponentRef Id="vcruntime140_1" />
        <ComponentRef Id="QtCoreDll" />
        <ComponentRef Id="QtGuiDll" />
        <ComponentRef Id="QtWidgetsDll" />
        <ComponentRef Id="QWindowsDll" />
      <?else?>
        <ComponentRef Id="QtCoredDll" />
        <ComponentRef Id="QtGuidDll" />
        <ComponentRef Id="QtWidgetsdDll" />
        <ComponentRef Id="QWindowsdDll" />
      <?endif?>
      <ComponentRef Id="SysProcs" />
      <ComponentRef Id="PrelaunchProcesses" />
      <ComponentRef Id="CreditsEn" />

      <ComponentRef Id="MeltypeEnglishList" />
      <ComponentRef Id="MeltypeEnglishWordsList" />
      <ComponentRef Id="MeltypeEnglishReadableList" />
      <ComponentRef Id="MeltypeJapaneseList" />
      <ComponentRef Id="MeltypeProperNounsList" />

      <ComponentRef Id="GenInterfaceFontRegular" />
      <ComponentRef Id="GenInterfaceFontBold" />
    </Feature>

    <Binary Id="JustType_installer_helper.dll" SourceFile="$(var.CustomActions64Path)" />

    <CustomAction Id="RegisterTIP64" DllEntry="RegisterTIP" Execute="deferred" Impersonate="no" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="RegisterTIPRollback64" DllEntry="RegisterTIPRollback" Execute="rollback" Impersonate="no" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="UnregisterTIP64" DllEntry="UnregisterTIP" Execute="deferred" Impersonate="no" Return="ignore" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="UnregisterTIPRollback64" DllEntry="UnregisterTIPRollback" Execute="rollback" Impersonate="no" Return="ignore" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="EnsureAllApplicationPackagesPermisssions" DllEntry="EnsureAllApplicationPackagesPermisssions" Execute="deferred" Impersonate="no" Return="ignore" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="ShutdownServer" DllEntry="ShutdownServer" Impersonate="yes" Return="ignore" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="RestoreUserIMEEnvironment" DllEntry="RestoreUserIMEEnvironment" Impersonate="yes" Return="ignore" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="InitialInstallation" DllEntry="InitialInstallation" Execute="deferred" Impersonate="no" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="InitialInstallationCommit" DllEntry="InitialInstallationCommit" Execute="commit" Impersonate="no" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="EnableTipProfile" DllEntry="EnableTipProfile" Execute="commit" Impersonate="yes" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="FixupConfigFilePermission" DllEntry="FixupConfigFilePermission" Execute="commit" Impersonate="yes" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="HideCancelButton" DllEntry="HideCancelButton" Return="ignore" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="SaveCustomActionData" DllEntry="SaveCustomActionData" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="RestoreServiceState" DllEntry="RestoreServiceState" Impersonate="no" Execute="deferred" Return="ignore" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="StopCacheServiceForRollback" DllEntry="StopCacheService" Impersonate="no" Execute="rollback" Return="ignore" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="InstallJustTypeFirewallRules" DllEntry="InstallJustTypeFirewallRules" Execute="deferred" Impersonate="no" Return="ignore" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="InstallJustTypeFirewallRulesRollback" DllEntry="RemoveJustTypeFirewallRules" Execute="rollback" Impersonate="no" Return="ignore" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="RemoveJustTypeFirewallRules" DllEntry="RemoveJustTypeFirewallRules" Execute="deferred" Impersonate="no" Return="ignore" BinaryRef="JustType_installer_helper.dll" />
    <CustomAction Id="NewerVersionError" Error="4000" />

    <!--
      Deferred and rollback custom actions run outside the client session and
      cannot read the session's properties.  Each helper that resolves a
      component path therefore receives the install directory through
      CustomActionData: a type 51 custom action named Set<Action>Data stores
      [JustTypeDir] into the property whose Id is the deferred action's own Id,
      and Windows Installer hands that value to the action as
      CustomActionData when it runs.  The value is read as the sequence table
      reaches the action, so each setter is sequenced ahead of its consumer.

      This matters after the move to ProgramFiles64Folder.  The helpers used to
      derive the directory from SystemUtil::GetServerDirectory(), which reads
      the TIP COM registration from the registry; during a fresh install that
      registration does not exist yet and during an upgrade it still points at
      the previous location.

      Only the actions that actually resolve a component path get a setter:
      RegisterTIP (and UnregisterTIPRollback, which re-runs RegisterTIP),
      EnsureAllApplicationPackagesPermisssions and InstallJustTypeFirewallRules.
      UnregisterTIP, RegisterTIPRollback and RemoveJustTypeFirewallRules work
      purely from COM GUIDs and rule names, so they need no data.

      Note: Windows Installer formats a directory property with a trailing
      backslash, so CustomActionData arrives as e.g.
      "C:\Program Files\JustType\".
    -->
    <CustomAction Id="SetRegisterTIP64Data" Property="RegisterTIP64" Value="[JustTypeDir]" />
    <CustomAction Id="SetUnregisterTIPRollback64Data" Property="UnregisterTIPRollback64" Value="[JustTypeDir]" />
    <CustomAction Id="SetEnsureAllApplicationPackagesPermisssionsData" Property="EnsureAllApplicationPackagesPermisssions" Value="[JustTypeDir]" />
    <CustomAction Id="SetInstallJustTypeFirewallRulesData" Property="InstallJustTypeFirewallRules" Value="[JustTypeDir]" />

    <InstallExecuteSequence>
      <Custom Action="InitialInstallation" After="InstallInitialize" Condition="(NOT (REMOVE=&quot;ALL&quot;)) AND (NOT UPGRADING)" />
      <Custom Action="HideCancelButton" After="InitialInstallation" />
      <Custom Action="SaveCustomActionData" Before="StopServices" Condition="(NOT (REMOVE=&quot;ALL&quot;))" />
      <StopServices />
      <DeleteServices />
      <Custom Action="RestoreUserIMEEnvironment" After="DeleteServices" Condition="(REMOVE=&quot;ALL&quot;) AND (NOT UPGRADINGPRODUCTCODE)" />
      <!-- This action invoked only when removal of the old product failed. -->
      <Custom Action="SetUnregisterTIPRollback64Data" Before="UnregisterTIPRollback64" Condition="(REMOVE=&quot;ALL&quot;) AND UPGRADINGPRODUCTCODE AND (VersionNT64)" />
      <Custom Action="UnregisterTIPRollback64" After="RestoreUserIMEEnvironment" Condition="(REMOVE=&quot;ALL&quot;) AND UPGRADINGPRODUCTCODE AND (VersionNT64)" />
      <Custom Action="UnregisterTIP64" After="UnregisterTIPRollback64" Condition="(REMOVE=&quot;ALL&quot;) AND (NOT UPGRADINGPRODUCTCODE) AND (VersionNT64)" />
      <Custom Action="RemoveJustTypeFirewallRules" After="UnregisterTIP64" Condition="(REMOVE=&quot;ALL&quot;)" />
      <!--
        The InstallValidate action notifies the user
        if JustType_server.exe and JustType_renderer.exe
        are currenly running. So the ShutdownServer action
        needs to be callled before the InstallValidate action.
      -->
      <Custom Action="ShutdownServer" Before="InstallValidate" />
      <Custom Action="NewerVersionError" After="FindRelatedProducts" Condition="NEWERVERSIONDETECTED" />
      <!--
        RemoveExistingProducts is scheduled right after InstallInitialize so
        that the previous product is fully uninstalled before any of the new
        files are written.  A late REP (between InstallExecute and
        InstallFinalize) lets Windows Installer keep an already-installed file
        whenever it considers the version/hash equivalent, which left stale
        binaries in place after an upgrade.
        http://msdn.microsoft.com/en-us/library/aa371197(VS.85).aspx
      -->
      <RemoveExistingProducts After="InstallInitialize" />
      <!--
        When the installer enters rollback mode, the cache service should be
        stopped before the remaining install actions run.
      -->
      <Custom Action="StopCacheServiceForRollback" Before="RestoreServiceState" Condition="(NOT (REMOVE=&quot;ALL&quot;))" />
      <Custom Action="RestoreServiceState" Before="RegisterTIPRollback64" Condition="(NOT (REMOVE=&quot;ALL&quot;))" />
      <!--
        If error occurs after RegisterTIP64,
        the registration needs to be canceled by registering the old product.
        So RegisterTIP64 needs to be scheduled after RemoveExistingProduct.
      -->
      <Custom Action="SetRegisterTIP64Data" Before="RegisterTIPRollback64" Condition="(NOT (REMOVE=&quot;ALL&quot;)) AND (VersionNT64)" />
      <Custom Action="RegisterTIPRollback64" Before="RegisterTIP64" Condition="(NOT (REMOVE=&quot;ALL&quot;)) AND (VersionNT64) AND (NOT UPGRADING)" />
      <Custom Action="RegisterTIP64" Before="EnsureAllApplicationPackagesPermisssions" Condition="(NOT (REMOVE=&quot;ALL&quot;)) AND (VersionNT64)" />
      <Custom Action="SetEnsureAllApplicationPackagesPermisssionsData" Before="EnsureAllApplicationPackagesPermisssions" Condition="(NOT (REMOVE=&quot;ALL&quot;))" />
      <Custom Action="EnsureAllApplicationPackagesPermisssions" Before="InstallJustTypeFirewallRulesRollback" Condition="(NOT (REMOVE=&quot;ALL&quot;))" />
      <Custom Action="InstallJustTypeFirewallRulesRollback" Before="InstallJustTypeFirewallRules" Condition="(NOT (REMOVE=&quot;ALL&quot;))" />
      <Custom Action="SetInstallJustTypeFirewallRulesData" Before="InstallJustTypeFirewallRules" Condition="(NOT (REMOVE=&quot;ALL&quot;))" />
      <Custom Action="InstallJustTypeFirewallRules" Before="InitialInstallationCommit" Condition="(NOT (REMOVE=&quot;ALL&quot;))" />
      <Custom Action="InitialInstallationCommit" Before="FixupConfigFilePermission" Condition="(NOT (REMOVE=&quot;ALL&quot;)) AND (NOT UPGRADING)" />
      <Custom Action="FixupConfigFilePermission" Before="EnableTipProfile" Condition="NOT (REMOVE=&quot;ALL&quot;)" />
      <Custom Action="EnableTipProfile" Before="InstallFinalize" Condition="NOT (REMOVE=&quot;ALL&quot;)" />
      <!-- show reboot dialog to execute pending file opartions -->
      <?if ($(var.VSConfigurationName) = "Release") ?>
        <ScheduleReboot After="InstallFinalize" Condition="(REMOVE=&quot;ALL&quot;) AND (NOT UPGRADINGPRODUCTCODE)" />
      <?endif?>
    </InstallExecuteSequence>

    <!--
      ProgramFiles64Folder, not ProgramFilesFolder.  Windows Installer resolves
      ProgramFilesFolder to the 32-bit Program Files folder, which installed the
      payload under "C:\Program Files (x86)\JustType".  Everything here is
      64-bit (JustType_server.exe, JustType_tip64.dll, the Qt 6 runtime), and
      the AppContainer visibility fixups and the bundled font lookup expect the
      native 64-bit Program Files folder.
    -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="JustTypeDir" Name="JustType">
        <Component Id="JustTypeConverter">
          <File Id="JustType_server.exe" Name="JustType_server.exe" DiskId="1" Checksum="yes" Source="$(var.JustTypeServer64Path)" Vital="yes" KeyPath="yes" />
        </Component>
        <Component Id="JustTypeCacheService">
          <!-- Always overwrite runtime binary during install/reinstall. -->
          <File Id="JustType_cache_service.exe" Name="JustType_cache_service.exe" DiskId="1" Checksum="yes" Source="$(var.JustTypeCacheService64Path)" Vital="yes" KeyPath="yes" />
          <!--
            To use localized description, set Description as follows:
              Description="@[#JustType_cache_service.exe],-N"
            where N is the resource ID for the description.
            http://msdn.microsoft.com/en-us/library/ms685156.aspx

            See win32/cache_service/mozc_cache_service_resource.h for resource IDs
            used below.

            The servie name specified in "Name" needs to be the same to
            |mozc::kMozcCacheServiceName| defined in base/const.h.
            TODO(yukawa): Share these parameters. http://b/2357270
          -->
          <ServiceInstall Id="JustTypeCacheService" Name="JustTypeCacheService" DisplayName="@[#JustType_cache_service.exe],-100" Description="@[#JustType_cache_service.exe],-101" Type="ownProcess" Start="auto" ErrorControl="normal" />
          <!--
            The following entry which stops our cache service both on
            installation and uninstallation should be the first entry in
            the ServiceControl table.  Otherwise, restart manager does not
            recognise that the specified service will be stopped during the
            instalaltion.  See http://b/2440272 for details.
          -->
          <ServiceControl Id="StopJustTypeCacheService" Name="JustTypeCacheService" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
        <!--
          Bitness="always64" even though JustType_tip32.dll is a 32-bit DLL.
          The whole payload lives in one 64-bit folder (JustTypeDir under
          ProgramFiles64Folder) so that TSF resolves both the 32-bit and the
          64-bit in-proc server from the same directory; splitting the 32-bit
          DLL into a separate 32-bit directory would break the path that
          RegisterTIP derives and that the TIP32 COM registration points at.

          always32 (the previous value) marked the component as bitness-neutral
          (Component.Attributes 0x0000) while its directory is 64-bit, which
          ICE80 reports as "This 32BitComponent uses 64BitDirectory".  The
          component owns no registry values and no other bitness-sensitive
          resource (verified: zero rows in the Registry table), so declaring it
          64-bit changes only the folder contract, not the installed payload:
          the file still lands in [JustTypeDir] with the same name.  The
          package is x64-only anyway (built with -arch x64, so the Template
          Summary Property declares Intel64), and Windows Installer refuses
          such a package on a 32-bit OS, so no machine that could install this
          MSI loses the file.
        -->
        <Component Id="JustTypeTIP32" Permanent="no" Bitness="always64">
          <File Id="JustType_tip32.dll" Name="JustType_tip32.dll" DiskId="1" Checksum="yes" Source="$(var.JustTypeTIP32Path)" Vital="yes" />
        </Component>
        <Component Id="JustTypeTIP64" Permanent="no" Bitness="always64">
          <File Id="JustType_tip64.dll" Name="JustType_tip64.dll" DiskId="1" Checksum="yes" Source="$(var.JustTypeTIP64Path)" Vital="yes" />
        </Component>
        <?if $(var.JustTypeTIP64ArmPath) != "" and $(var.JustTypeTIP64XPath) != "" ?>
          <Component Id="JustTypeTIP64Arm" Permanent="no" Bitness="always64">
            <File Id="JustType_tip64arm.dll" Name="JustType_tip64arm.dll" DiskId="1" Checksum="yes" Source="$(var.JustTypeTIP64ArmPath)" Vital="yes" />
          </Component>
          <Component Id="JustTypeTIP64X" Permanent="no" Bitness="always64">
            <File Id="JustType_tip64x.dll" Name="JustType_tip64x.dll" DiskId="1" Checksum="yes" Source="$(var.JustTypeTIP64XPath)" Vital="yes" />
          </Component>
        <?endif?>
        <Component Id="JustTypeBroker" Permanent="no">
          <File Id="JustType_broker.exe" Name="JustType_broker.exe" DiskId="1" Checksum="yes" Source="$(var.JustTypeBroker64Path)" Vital="yes" KeyPath="yes" />
        </Component>
        <Component Id="JustTypeRenderer">
          <File Id="JustType_renderer.exe" Name="JustType_renderer.exe" DiskId="1" Vital="yes" Checksum="yes" Source="$(var.JustTypeRenderer64Path)" KeyPath="yes" />
        </Component>
        <Component Id="JustTypeTool">
          <File Id="JustType_tool.exe" Name="JustType_tool.exe" DiskId="1" Checksum="yes" Source="$(var.JustTypeToolPath)" Vital="yes" KeyPath="yes" />
        </Component>

        <!--
          Meltype's English/Japanese dictionaries.  Installed as
          <JustTypeDir>\meltype_dictionaries, which is the directory
          MeltypeBridge::ResolveDictionaryDirectory() looks in next to the server
          binary.  Without these the segmenter finds no data, IsAvailable()
          returns false and the mixed-script segmentation silently does nothing.
        -->
        <Directory Id="MeltypeDictionariesDir" Name="meltype_dictionaries">
          <Component Id="MeltypeEnglishList">
            <File Id="meltype_english_txt" Name="english.txt" DiskId="1" Source="$(var.MeltypeEnglishPath)" Vital="yes" KeyPath="yes" />
          </Component>
          <Component Id="MeltypeEnglishWordsList">
            <File Id="meltype_english_words_txt" Name="english-words.txt" DiskId="1" Source="$(var.MeltypeEnglishWordsPath)" Vital="yes" KeyPath="yes" />
          </Component>
          <Component Id="MeltypeEnglishReadableList">
            <File Id="meltype_english_readable_txt" Name="english-readable.txt" DiskId="1" Source="$(var.MeltypeEnglishReadablePath)" Vital="yes" KeyPath="yes" />
          </Component>
          <Component Id="MeltypeJapaneseList">
            <File Id="meltype_japanese_txt" Name="japanese.txt" DiskId="1" Source="$(var.MeltypeJapanesePath)" Vital="yes" KeyPath="yes" />
          </Component>
          <Component Id="MeltypeProperNounsList">
            <File Id="meltype_propernouns_txt" Name="propernouns.txt" DiskId="1" Source="$(var.MeltypeProperNounsPath)" Vital="yes" KeyPath="yes" />
          </Component>
        </Directory>

        <?if $(var.VSConfigurationName) = "Release" ?>
          <Component Id="msvcp140">
            <File Id="msvcp140.dll" Name="msvcp140.dll" DiskId="1" Checksum="yes" Source="$(var.ReleaseRedistCrt64Dir)/msvcp140.dll" />
          </Component>
          <Component Id="msvcp140_1">
            <File Id="msvcp140_1.dll" Name="msvcp140_1.dll" DiskId="1" Checksum="yes" Source="$(var.ReleaseRedistCrt64Dir)/msvcp140_1.dll" />
          </Component>
          <Component Id="msvcp140_2">
            <File Id="msvcp140_2.dll" Name="msvcp140_2.dll" DiskId="1" Checksum="yes" Source="$(var.ReleaseRedistCrt64Dir)/msvcp140_2.dll" />
          </Component>
          <Component Id="vcruntime140">
            <File Id="vcruntime140.dll" Name="vcruntime140.dll" DiskId="1" Checksum="yes" Source="$(var.ReleaseRedistCrt64Dir)/vcruntime140.dll" />
          </Component>
          <Component Id="vcruntime140_1">
            <File Id="vcruntime140_1.dll" Name="vcruntime140_1.dll" DiskId="1" Checksum="yes" Source="$(var.ReleaseRedistCrt64Dir)/vcruntime140_1.dll" />
          </Component>
          <Component Id="QtCoreDll">
            <!-- Always overwrite: b/31845781 -->
            <RemoveFile Id="$(var.QtCoreFilename)" Name="$(var.QtCoreFilename)" On="install" />
            <File Id="$(var.QtCoreFilename)" Name="$(var.QtCoreFilename)" DiskId="1" Vital="yes" Checksum="yes" Source="$(var.QtDir)/bin/$(var.QtCoreFilename)" />
          </Component>
          <Component Id="QtGuiDll">
            <!-- Always overwrite: b/31845781 -->
            <RemoveFile Id="$(var.QtGuiFilename)" Name="$(var.QtGuiFilename)" On="install" />
            <File Id="$(var.QtGuiFilename)" Name="$(var.QtGuiFilename)" DiskId="1" Vital="yes" Checksum="yes" Source="$(var.QtDir)/bin/$(var.QtGuiFilename)" />
          </Component>
          <Component Id="QtWidgetsDll">
            <!-- Always overwrite: b/31845781 -->
            <RemoveFile Id="$(var.QtWidgetsFilename)" Name="$(var.QtWidgetsFilename)" On="install" />
            <File Id="$(var.QtWidgetsFilename)" Name="$(var.QtWidgetsFilename)" DiskId="1" Vital="yes" Checksum="yes" Source="$(var.QtDir)/bin/$(var.QtWidgetsFilename)" />
          </Component>
        <?else?>
          <Component Id="QtCoredDll">
            <!-- Always overwrite: b/31845781 -->
            <RemoveFile Id="$(var.QtCoredFilename)" Name="$(var.QtCoredFilename)" On="install" />
            <File Id="$(var.QtCoredFilename)" Name="$(var.QtCoredFilename)" DiskId="1" Vital="yes" Checksum="yes" Source="$(var.QtDir)/bin/$(var.QtCoredFilename)" />
          </Component>
          <Component Id="QtGuidDll">
            <!-- Always overwrite: b/31845781 -->
            <RemoveFile Id="$(var.QtGuidFilename)" Name="$(var.QtGuidFilename)" On="install" />
            <File Id="$(var.QtGuidFilename)" Name="$(var.QtGuidFilename)" DiskId="1" Vital="yes" Checksum="yes" Source="$(var.QtDir)/bin/$(var.QtGuidFilename)" />
          </Component>
          <Component Id="QtWidgetsdDll">
            <!-- Always overwrite: b/31845781 -->
            <RemoveFile Id="$(var.QtWidgetsdFilename)" Name="$(var.QtWidgetsdFilename)" On="install" />
            <File Id="$(var.QtWidgetsdFilename)" Name="$(var.QtWidgetsdFilename)" DiskId="1" Vital="yes" Checksum="yes" Source="$(var.QtDir)/bin/$(var.QtWidgetsdFilename)" />
          </Component>
        <?endif?>
        <Directory Id="DocumentsDir" Name="documents">
          <Component Id="CreditsEn">
            <File Id="credits_en.html" Name="credits_en.html" DiskId="1" Checksum="yes" Vital="yes" Source="$(var.DocumentsDir)/credits_en.html" />
          </Component>
        </Directory>
        <Directory Id="QtPlatformsPluginDir" Name="platforms">
          <?if $(var.VSConfigurationName) = "Debug" ?>
            <Component Id="QWindowsdDll">
              <!-- Always overwrite: b/31845781 -->
              <RemoveFile Id="qwindowsd.dll" Name="qwindowsd.dll" On="install" />
              <File Id="qwindowsd.dll" Name="qwindowsd.dll" DiskId="1" Vital="yes" Checksum="yes" Source="$(var.QtDir)/plugins/platforms/qwindowsd.dll" />
            </Component>
          <?else?>
            <Component Id="QWindowsDll">
              <!-- Always overwrite: b/31845781 -->
              <RemoveFile Id="qwindows.dll" Name="qwindows.dll" On="install" />
              <File Id="qwindows.dll" Name="qwindows.dll" DiskId="1" Vital="yes" Checksum="yes" Source="$(var.QtDir)/plugins/platforms/qwindows.dll" />
            </Component>
          <?endif?>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!--
      Gen Interface JP Display faces, installed into the Windows system font
      folder (FontsFolder) with TrueType="yes" so the Font table entry is
      generated and the family is registered machine wide.  The previous
      per-process registrations (AddFontResourceExW with FR_PRIVATE in the
      renderer, QFontDatabase::addApplicationFont in the config dialog) never
      entered the DirectWrite system font collection, so the candidate window
      fell back to a substitute face; DirectWrite, GDI and Qt all resolve the
      system-installed family without any per-process registration.
      Permanent="yes": the faces stay registered for the OS after uninstall.
    -->
    <StandardDirectory Id="FontsFolder">
      <Component Id="GenInterfaceFontRegular" Permanent="yes">
        <File Id="GenInterfaceJPDisplay_Regular_ttf" Name="GenInterfaceJPDisplay-Regular.ttf" Source="$(var.GenInterfaceJpDisplayRegularPath)" TrueType="yes" Vital="yes" KeyPath="yes" />
      </Component>
      <Component Id="GenInterfaceFontBold" Permanent="yes">
        <File Id="GenInterfaceJPDisplay_Bold_ttf" Name="GenInterfaceJPDisplay-Bold.ttf" Source="$(var.GenInterfaceJpDisplayBoldPath)" TrueType="yes" Vital="yes" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!--
      Write registry keys to make sure JustType_server.exe and
      JustType_renderer.exe exit when a user logoff via remote desctop
      connection.
    -->
    <Component Id="SysProcs" Directory="TARGETDIR">
      <RegistryValue Id="SysProcsJustTypeConverter" Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\Terminal Server\SysProcs" Name="JustType_server.exe" Value="0" Action="write" Type="integer" />
      <RegistryValue Id="SysProcsJustTypeRenderer" Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\Terminal Server\SysProcs" Name="JustType_renderer.exe" Value="0" Action="write" Type="integer" />
    </Component>

    <!--
      Write a registry key to launch JustType_server.exe and
      JustType_renderer.exe automatically after user logon.
    -->
    <Component Id="PrelaunchProcesses" Directory="TARGETDIR">
      <RegistryValue Id="RunBroker" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="JustType Prelauncher" Action="write" Type="string" Value="&quot;[JustTypeDir]JustType_broker.exe&quot; --mode=prelaunch_processes" />
    </Component>
  </Package>
</Wix>
